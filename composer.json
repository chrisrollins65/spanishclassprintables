{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "masbug/flysystem-google-drive-ext",
                "version": "2.5.0.1",
                "type": "library",
                "license": "Apache-2.0",
                "description": "Upstream v2.5.0, unmodified code, with its vestigial guzzlehttp/guzzle ^6.3|^7.0 requirement dropped. The adapter imports four GuzzleHttp\\Psr7 classes and never the HTTP client, so the cap only blocked Guzzle 8. See app/Providers/GoogleDriveServiceProvider.php.",
                "require": {
                    "php": "^8.0",
                    "ext-mbstring": "*",
                    "google/apiclient": "^2.2",
                    "guzzlehttp/psr7": "^2.0|^3.0",
                    "league/flysystem": "^3.0"
                },
                "autoload": {
                    "psr-4": {
                        "Masbug\\Flysystem\\": "src"
                    }
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/masbug/flysystem-google-drive-ext/zipball/90123f15752da2e2e290e8630c41eebf172d7fec",
                    "reference": "90123f15752da2e2e290e8630c41eebf172d7fec"
                }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/fortify": "^1.39",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "masbug/flysystem-google-drive-ext": "^2.5",
        "spatie/browsershot": "^5.4",
        "spatie/laravel-backup": "^10.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.8",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
