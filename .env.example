APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# `database` in production, and a supervisor worker to drain it. On `sync` the
# AI writes and the PDF renders happen INSIDE the web request, which takes
# tens of seconds and times out.
QUEUE_CONNECTION=sync
# Longer than the longest job (WriteGame, 400s), or the queue decides a job
# that is still running has died and runs it a second time — a second model
# call, charged to the teacher's credit again. See QueueTimeoutTest.
DB_QUEUE_RETRY_AFTER=600

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shared secret for the local packet builder's room publish call.
ROOM_PUBLISH_SECRET=

# Shared secret for the builder's pin image uploads (/api/internal/pin-asset).
# Must match PIN_ASSET_SECRET in the builder's .env. Leave empty and the
# endpoint refuses every upload. Pins older than the retention window are
# deleted the next time one is uploaded.
PIN_ASSET_SECRET=
PIN_ASSET_RETENTION_DAYS=14

# Homepage. The demo room is linked for visitors with no code of their own
# (hidden when empty). Contact form messages are always saved to the
# contact_messages table, and also emailed here when it is set.
DEMO_ROOM_CODE=
CONTACT_INBOX=

# Optional Cloudflare Turnstile captcha on the contact form (dash.cloudflare.com
# > Turnstile). Leave either empty and the form runs without it.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Who may reach /admin, by email address, comma separated.
ADMIN_EMAILS=

# Paddle is the merchant of record: it sells to the teacher and tells us
# through the webhook. The secret signs that webhook; the API key is only used
# to start a refund from our own admin screens.
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_API_URL=https://api.paddle.com
PADDLE_CLIENT_TOKEN=
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRICE_SINGLE=
PADDLE_CREDITS_SINGLE=1
PADDLE_PRICE_BUNDLE=
PADDLE_CREDITS_BUNDLE=10

# Who is behind the site, for the legal pages (/terms, /privacy, /refunds).
# The defaults in config/site.php are the real ones, so these only need setting
# if something changes.
LEGAL_NAME=
# Left empty on purpose: with no value the notice simply does not mention a tax
# number, rather than showing a gap. Set it if the gestor asks for it.
LEGAL_NIF=
LEGAL_EMAIL=
# Bumped by hand when a legal page changes in a way a reader should notice.
LEGAL_UPDATED=
# The window an unspent credit can be refunded in, stated on both the refund
# policy and the pricing page.
REFUND_DAYS=14

# The homepage's email signup. The defaults in config/site.php are the real
# account, so leaving these empty still works — they are here so the account
# can be moved without a code change.
MAILERLITE_ACCOUNT=
MAILERLITE_FORM=

# Writing a teacher's game, and changing one. Without a key the site still
# works — a teacher can write their own game by hand — so these are checked at
# the button rather than at boot (Writer, TeacherGameController::create).
GEMINI_API_KEY=
OPENAI_API_KEY=

# What one credit's worth of AI may cost us, in cents, and when the teacher is
# shown a meter. Most never approach it, which is why the meter stays hidden
# until this far through.
AI_CENTS_PER_CREDIT=50
AI_METER_FROM_PERCENT=75

# The whole site's AI spend in one day. The first logs a warning, the second
# stops writing until tomorrow — a fuse against a loop, not a per-teacher cap.
AI_DAILY_WARN_CENTS=500
AI_DAILY_STOP_CENTS=2000

# Which models write, and what they cost per million tokens, so a credit's
# budget is measured rather than guessed.
AI_PROVIDER=gemini
AI_MODEL=gemini-3-flash-preview
AI_INPUT_PER_M=0.25
AI_OUTPUT_PER_M=1.50
AI_FALLBACK_PROVIDER=chatgpt
AI_FALLBACK_MODEL=gpt-5.4
AI_FALLBACK_INPUT_PER_M=1.25
AI_FALLBACK_OUTPUT_PER_M=10.0

# Card PDFs are rendered by headless Chrome. Ansible installs Google's own
# package, so in production this is /usr/bin/google-chrome; leave it empty in
# development, where puppeteer's own copy is found. NO_SANDBOX is needed on the
# droplet, which runs this as the web user without the namespaces Chrome wants.
BROWSERSHOT_CHROME_PATH=
BROWSERSHOT_NODE_BINARY=
BROWSERSHOT_NPM_BINARY=
BROWSERSHOT_NO_SANDBOX=false

# Node runs the builder's own code: the bingo card dealer, and every AI prompt
# (resources/scripts/game-ai.cjs). Empty means "on the PATH", which is thinner
# under php-fpm and supervisor than in a shell — name it in production.
CARDS_NODE_BINARY=

# The development tunnel (php artisan tunnel), so webhooks can reach this
# machine. Run `php artisan tunnel:setup <hostname>` once per machine.
TUNNEL_CLOUDFLARED='C:\Program Files (x86)\cloudflared\cloudflared.exe'
# Defaults to scp-dev-<this machine's name>; set it only to share one tunnel
# deliberately.
TUNNEL_NAME=
TUNNEL_DOMAIN=
TUNNEL_LOCAL_URL=http://localhost:80
TUNNEL_LOCAL_HOST=spanishclassprintables.test

# Nightly backups (spatie/laravel-backup -> Google Drive). Leave the whole
# block empty in development: nothing schedules a backup locally, and the
# `google` disk is only resolved when one runs.
#
# The OAuth client is shared with the other sites on this droplet.
# GOOGLE_DRIVE_FOLDER is a path of folder NAMES from the top of My Drive. The
# archives land directly in it, because config/backup.php's 'name' is that
# same folder's Drive ID — change one and the other has to follow. The
# retention sweep deletes from the whole folder, so it must belong to this
# site alone. In production: GOOGLE_DRIVE_FOLDER="SpanishClassPrintables/backups"
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER=
# Encrypts the archive, which contains the .env and so every key above. Losing
# this password loses the backups with it: keep it where you keep the .env
# decrypt key, NOT only in the .env it encrypts.
BACKUP_ARCHIVE_PASSWORD=
